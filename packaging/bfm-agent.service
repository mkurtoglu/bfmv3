[Unit]
Description=BFM agent (PostgreSQL role changes and VIP)
Documentation=https://github.com/mkurtoglu/bfmv3
After=network-online.target
Wants=network-online.target

[Service]
User=postgres
Group=postgres
EnvironmentFile=-/etc/bfm/agent.env
ExecStart=/usr/bin/bfm-agent
Restart=always
RestartSec=2
# The agent starts and stops PostgreSQL itself; disable the PostgreSQL unit (systemctl disable postgresql-16).
# KillMode=process keeps PostgreSQL running when the agent is restarted or stopped.
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
