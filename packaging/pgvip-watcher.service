[Unit]
Description=pgVIP watcher (failover decisions, console and API)
Documentation=https://github.com/mkurtoglu/bfmv3
After=network-online.target
Wants=network-online.target

[Service]
User=pgvip
Group=pgvip
EnvironmentFile=-/etc/pgvip/watcher.env
ExecStart=/usr/bin/pgvip-watcher
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/pgvip-watcher

[Install]
WantedBy=multi-user.target
