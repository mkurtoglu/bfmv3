[Unit]
Description=BFM watcher (failover decisions, console and API)
Documentation=https://github.com/mkurtoglu/bfmv3
After=network-online.target
Wants=network-online.target

[Service]
User=bfm
Group=bfm
EnvironmentFile=-/etc/bfm/watcher.env
ExecStart=/usr/bin/bfm-watcher
Restart=always
# the JVM ends with 143 on SIGTERM: a stopped service is "inactive", not "failed"
SuccessExitStatus=143
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/bfm-watcher

[Install]
WantedBy=multi-user.target
