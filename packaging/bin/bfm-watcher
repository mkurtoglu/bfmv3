#!/bin/bash
# Starts the BFM watcher with /etc/bfm/watcher.yml, or runs one of its commands:
#   bfm-watcher hash-password     prints a password hash for bfm.users (reads the password from stdin or a tty)
#   bfm-watcher setup             writes /etc/bfm/watcher.yml, the certificates and a CA (run as root; --help)
# JVM options can be set in BFM_WATCHER_JAVA_OPTS, the Java runtime in BFM_JAVA, for example in /etc/bfm/watcher.env.
JAR=/usr/share/bfm/bfm-watcher.jar
# Java 21 or newer: BFM_JAVA, else a Java 21 runtime from the distribution's packages (the default "java" may be an
# older one on hosts that have several), else the first java on PATH.
java_bin() {
  if [ -n "${BFM_JAVA:-}" ]; then
    echo "$BFM_JAVA"
    return
  fi
  for j in /usr/lib/jvm/jre-21/bin/java /usr/lib/jvm/jre-21-openjdk/bin/java /usr/lib/jvm/java-21-openjdk/bin/java \
           /usr/lib/jvm/java-21-openjdk-*/bin/java /usr/lib/jvm/jre-21-openjdk-*/bin/java; do
    if [ -x "$j" ]; then
      echo "$j"
      return
    fi
  done
  echo java
}
JAVA=$(java_bin)
case "${1:-}" in
  hash-password|setup)
    exec "$JAVA" -Xmx256m -jar "$JAR" "$@"
    ;;
  *)
    exec "$JAVA" ${BFM_WATCHER_JAVA_OPTS:--Xmx512m} -jar "$JAR" \
      --spring.config.additional-location=file:/etc/bfm/watcher.yml "$@"
    ;;
esac
