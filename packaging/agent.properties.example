# MiniPG agent settings: /etc/bfm/minipgagent/agent.properties, readable by the postgres user only (600).
# Start: minipgagent (installed by the RPM with minipgagent.service; runs /usr/share/bfm/minipgagent.jar)
# Several PostgreSQL instances on this host: one agent instance each, minipgagent@<instance>.service, with
# this file at /etc/bfm/minipgagent/<instance>/agent.properties (see docs/install.md, "Several clusters on
# one host").
# Every setting with its default and what it does: docs/agent-config.md
#
# Passwords and the token can also come from the environment (/etc/bfm/minipgagent/agent.env, read by the
# unit): MINIPGAGENT_KEYSTORE_PASSWORD, MINIPGAGENT_TRUSTSTORE_PASSWORD, MINIPGAGENT_API_TOKEN. The
# environment wins over the property, and the property over its .file form.

# Must equal the node name in the watcher configuration (and the name in this node's certificate).
node.name=pg-a1
listen.address=0.0.0.0
# One port per agent instance on a host (8008, 8009, ...).
listen.port=8008

# The cluster this agent belongs to. Empty: it binds to the first watcher group that sends it a command and
# refuses commands for any other cluster from then on (kept in state.dir/binding). Set it to the cluster id the
# console shows to bind it explicitly.
#cluster.id=
# Set by minipgagent@<instance>.service; only needed when starting the agent another way.
#instance.name=

# Mutual TLS: only holders of a certificate signed by the BFM CA may call the agent (see bfm-make-certs).
tls.enabled=true
tls.keystore=/etc/bfm/minipgagent/pg-a1.p12
tls.keystore.password.file=/etc/bfm/minipgagent/pg-a1.pass
tls.truststore=/etc/bfm/minipgagent/ca.p12
tls.truststore.password.file=/etc/bfm/minipgagent/ca.pass
# Optional second check; required when TLS is off (lab only). Also read from MINIPGAGENT_API_TOKEN.
#api.token.file=/etc/bfm/minipgagent/agent.token

# Epoch, fence flag, lease, cluster binding and logs of background operations. Default: /var/lib/minipgagent,
# or /var/lib/minipgagent/<instance> for an agent instance. Locked while the agent runs: two agents can never
# share one.
#state.dir=/var/lib/minipgagent

# PostgreSQL. The agent talks to it with psql over the Unix socket (peer authentication, no password).
pg.bin=/usr/pgsql-16/bin
pg.data=/var/lib/pgsql/16/data
pg.port=5432
pg.socket.dir=/var/run/postgresql
pg.user=postgres
pg.database=postgres
pg.start.timeout.seconds=120
pg.promote.timeout.seconds=60
# Start a stopped replica when the agent comes up (needs standby.signal; never a primary). Off: the watcher
# starts it. Useful when a node reboots while no watcher is up.
pg.autostart.replica=false
# Commands are templates split on whitespace before {bin} {data} {port} {state} {node} {mode} {timeout}
# are filled. No shell is involved.
#pg.start.command={bin}/pg_ctl -D {data} -l {state}/postgres-start.log -w -t {timeout} start
#pg.stop.command={bin}/pg_ctl -D {data} -m {mode} -w -t {timeout} stop
#pg.status.command={bin}/pg_ctl -D {data} status

# Streaming replication, pg_rewind and pg_basebackup.
replication.user=replicator
replication.passfile=/var/lib/pgsql/.pgpass
rewind.user=postgres
replication.conninfo.extra=sslmode=prefer
# Keep the old data directory (renamed) when a node is re-initialized.
reinit.keep.old=true

# The virtual IP that follows the primary. The agent brings it up with sudo ip addr add and refuses to promote
# while it is not up on this node. See sudoers-minipgagent.
vip.enabled=true
vip.address=192.168.0.50
vip.prefix=24
vip.interface=eth0
# Duplicate address detection before bringing the VIP up: if another host answers, nothing is added.
vip.dad.enabled=true
#vip.add.command=sudo -n /usr/sbin/ip addr add {vip}/{prefix} dev {iface}
#vip.del.command=sudo -n /usr/sbin/ip addr del {vip}/{prefix} dev {iface}
#vip.show.command=/usr/sbin/ip -o -4 addr show dev {iface}
#vip.dad.command=sudo -n /usr/sbin/arping -D -q -c 2 -w 3 -I {iface} {vip}
#vip.garp.command=sudo -n /usr/sbin/arping -U -q -c 3 -I {iface} {vip}

# What a primary does when its lease from the watchers runs out (only when the watcher enables self-fencing):
# stop = release the VIP and stop PostgreSQL; vip-only = release the VIP and keep PostgreSQL running.
fence.action=stop
fence.stop.mode=immediate

# Optional Linux watchdog while primary: if the agent hangs, the kernel resets the machine. The reset takes
# every PostgreSQL instance on the host down, so only one agent per host may use it (a host-wide lock).
watchdog.enabled=false
#watchdog.device=/dev/watchdog
#watchdog.interval.ms=5000
#watchdog.lock=/var/lib/minipgagent/watchdog.lock

command.timeout.seconds=30
probe.interval.ms=1000
