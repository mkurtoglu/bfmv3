# BFM agent settings: /etc/bfm/agent.properties, readable by the postgres user only (chmod 600).
# Start: bfm-agent (installed by the RPM with bfm-agent.service; runs java -jar /usr/share/bfm/bfm-agent.jar)
# Every setting with its default and what it does: docs/agent-config.md
#
# Passwords and the token can also come from the environment (/etc/bfm/agent.env, read by the unit):
# BFM_KEYSTORE_PASSWORD, BFM_TRUSTSTORE_PASSWORD, BFM_API_TOKEN. The environment wins over the property,
# and the property over its .file form.

# Must equal the node name in the watcher configuration.
node.name=pg-a1
listen.address=0.0.0.0
listen.port=8008

# Mutual TLS: only holders of a certificate signed by the BFM CA may call the agent (see bfm-make-certs).
tls.enabled=true
tls.keystore=/etc/bfm/pg-a1.p12
tls.keystore.password.file=/etc/bfm/pg-a1.pass
tls.truststore=/etc/bfm/ca.p12
tls.truststore.password.file=/etc/bfm/ca.pass
# Optional second check; required when TLS is off (lab only). Also read from BFM_API_TOKEN.
#api.token.file=/etc/bfm/agent.token

# Epoch, fence flag and logs of background operations.
state.dir=/var/lib/bfm

# PostgreSQL. The agent talks to it with psql over the Unix socket (peer authentication, no password).
pg.bin=/usr/pgsql-16/bin
pg.data=/var/lib/pgsql/16/data
pg.port=5432
pg.socket.dir=/var/run/postgresql
pg.user=postgres
pg.database=postgres
pg.start.timeout.seconds=120
pg.promote.timeout.seconds=60
# Commands are templates split on whitespace before {bin} {data} {port} {state} {node} {mode} {timeout}
# are filled. No shell is involved.
#pg.start.command={bin}/pg_ctl -D {data} -l {state}/postgres-start.log -w -t {timeout} start
#pg.stop.command={bin}/pg_ctl -D {data} -m {mode} -w -t {timeout} stop
#pg.status.command={bin}/pg_ctl -D {data} status

# Streaming replication, pg_rewind and pg_basebackup.
replication.user=replicator
replication.passfile=/var/lib/pgsql/.pgpass
rewind.user=postgres
replication.conninfo.extra=sslmode=prefer
# Keep the old data directory (renamed) when a node is re-initialized.
reinit.keep.old=true

# The virtual IP that follows the primary. The agent brings it up with sudo ip addr add and refuses to promote
# while it is not up on this node. See sudoers-bfm.
vip.enabled=true
vip.address=192.168.0.50
vip.prefix=24
vip.interface=eth0
# Duplicate address detection before bringing the VIP up: if another host answers, nothing is added.
vip.dad.enabled=true
#vip.add.command=sudo -n /usr/sbin/ip addr add {vip}/{prefix} dev {iface}
#vip.del.command=sudo -n /usr/sbin/ip addr del {vip}/{prefix} dev {iface}
#vip.show.command=/usr/sbin/ip -o -4 addr show dev {iface}
#vip.dad.command=sudo -n /usr/sbin/arping -D -q -c 2 -w 3 -I {iface} {vip}
#vip.garp.command=sudo -n /usr/sbin/arping -U -q -c 3 -I {iface} {vip}

# What a primary does when its lease from the watchers runs out (only when the watcher enables self-fencing):
# stop = release the VIP and stop PostgreSQL; vip-only = release the VIP and keep PostgreSQL running.
fence.action=stop
fence.stop.mode=immediate

# Optional Linux watchdog while primary: if the agent hangs, the kernel resets the machine.
watchdog.enabled=false
#watchdog.device=/dev/watchdog
#watchdog.interval.ms=5000

command.timeout.seconds=30
probe.interval.ms=1000
